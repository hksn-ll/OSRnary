<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Clean Specular Frosted Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E6FFFFFF"
                android:centerColor="#D4F8FAFC"
                android:endColor="#C4F1F5F9"
                android:type="linear" />
        </shape>
    </item>
    <!-- Prismatic bottom hairline edge stroke -->
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1A000000" />
        </shape>
    </item>
</layer-list>
