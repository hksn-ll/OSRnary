<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Clean Specular Frosted Glass Base with Top-to-Bottom Feathering -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FAFBFD"
                android:centerColor="#F1F5F9"
                android:endColor="#E2E8F0"
                android:type="linear" />
        </shape>
    </item>
    <!-- Prismatic bottom hairline edge stroke -->
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#14000000" />
        </shape>
    </item>
</layer-list>
