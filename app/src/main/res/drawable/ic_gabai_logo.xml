            android:fillAlpha="0.9" />
        <path
            android:pathData="M 342,126 Q 342,138 354,138 Q 342,138 342,150 Q 342,138 330,138 Q 342,138 342,126 Z"
            android:fillColor="#FFFFFF" />

        <!-- Tertiary Floating Teal Pip -->
        <path
            android:pathData="M 176,144 m -6,0 a 6,6 0 1,0 12,0 a 6,6 0 1,0 -12,0"
            android:fillColor="#00F5D4" />
        <path
            android:pathData="M 176,144 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
