<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Indigo-Violet Aurora Stage Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="315"
                android:centerColor="#2E1065"
                android:endColor="#1E1B4B"
                android:startColor="#4C1D95"
                android:type="linear" />
        </shape>
    </item>
    <!-- Top-Left Soft Violet Radial Bloom -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:centerX="0.15"
                android:centerY="0.15"
                android:endColor="#008B5CF6"
                android:gradientRadius="220dp"
                android:startColor="#4D8B5CF6"
                android:type="radial" />
        </shape>
    </item>
    <!-- Bottom-Right Mint-Cyan Radial Bloom -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:centerX="0.88"
                android:centerY="0.88"
                android:endColor="#0010B981"
                android:gradientRadius="200dp"
                android:startColor="#3810B981"
                android:type="radial" />
        </shape>
    </item>
    <!-- Specular Inner Hairline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
