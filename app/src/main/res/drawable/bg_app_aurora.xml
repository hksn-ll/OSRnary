<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F4FAFD"
                android:centerColor="#F0F6F9"
                android:endColor="#F4FAFD" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#26E4DFFF"
                android:endColor="#00E4DFFF"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="480dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#20FFD8EA"
                android:endColor="#00FFD8EA"
                android:centerX="1.0"
                android:centerY="0.12"
                android:gradientRadius="450dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#1E6DFAD2"
                android:endColor="#006DFAD2"
                android:centerX="1.0"
                android:centerY="0.55"
                android:gradientRadius="500dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#22C6BFFF"
                android:endColor="#00C6BFFF"
                android:centerX="0.0"
                android:centerY="0.90"
                android:gradientRadius="500dp" />
        </shape>
    </item>
</layer-list>
