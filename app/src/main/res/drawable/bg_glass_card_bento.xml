<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Depth Shadow Underlay -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#0A0F172A" />
        </shape>
    </item>
    <!-- Specular Translucent Glass Body -->
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#8AFFFFFF"
                android:centerColor="#4DFFFFFF"
                android:endColor="#2BFFFFFF"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1.2dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
