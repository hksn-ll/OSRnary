<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#336C5CE7">
    <item>
        <layer-list>
            <!-- Ambient Shadow -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#0D000000" />
                </shape>
            </item>
            <!-- Specular Frosted Glass Pill -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:startColor="#99FFFFFF"
                        android:centerColor="#66FFFFFF"
                        android:endColor="#40FFFFFF"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#CCFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
