<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glowing Radiant Aura -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#006C5CE7"
                android:centerColor="#38818CF8"
                android:endColor="#006C5CE7"
                android:type="linear" />
        </shape>
    </item>

    <!-- Neon Center Laser Beam -->
    <item
        android:gravity="center"
        android:height="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00818CF8"
                android:centerColor="#FFFFFFFF"
                android:endColor="#00818CF8"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
