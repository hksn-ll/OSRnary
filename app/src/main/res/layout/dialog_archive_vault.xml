<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modern_dialog"
    android:fontFamily="@font/font_plus_jakarta_sans"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_modern_primary">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🗄️"
                android:textSize="18sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Archive &amp; Recycle Vault"
                android:textColor="#1E1B4B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_vault_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campus Safety Net • 30-Day Recovery"
                android:textColor="#6366F1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="32dp"
                android:paddingHorizontal="14dp"
                android:text="All"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_modern_primary"
                android:layout_marginEnd="6dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/chip_filter_students"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="32dp"
                android:paddingHorizontal="14dp"
                android:text="Students"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_btn_modern_secondary"
                android:layout_marginEnd="6dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/chip_filter_materials"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="32dp"
                android:paddingHorizontal="14dp"
                android:text="Materials"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_btn_modern_secondary"
                android:layout_marginEnd="6dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/chip_filter_classes"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="32dp"
                android:paddingHorizontal="14dp"
                android:text="Classes"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_btn_modern_secondary"
                android:layout_marginEnd="6dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/chip_filter_subjects"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="32dp"
                android:paddingHorizontal="14dp"
                android:text="Subjects"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_btn_modern_secondary"
                android:layout_marginEnd="6dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/chip_filter_assessments"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="32dp"
                android:paddingHorizontal="14dp"
                android:text="Assessments"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_btn_modern_secondary"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable Archive Vault List -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="340dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/container_archive_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_no_archives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:text="No archived records found in this vault."
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <android.widget.Button
        android:id="@+id/btn_close_vault"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_btn_modern_secondary"
        android:text="Close Vault"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null" />
</LinearLayout>
