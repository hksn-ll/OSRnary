<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvTeacherWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, Educator!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1E3A8A" /> <Button
    android:id="@+id/btnManageClasses"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="Manage My Class Sections" />

    <Button
        android:id="@+id/btnAssignMaterials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Assign Reading Materials" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Active Classes:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2D3436"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/classes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>
</LinearLayout>