<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EDF2F7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/history_click_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Header Row: Word Title & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/history_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="Explored Vocabulary"
                android:textColor="#1E1B4B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/history_pos_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pos_pill"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="NOUN"
                android:textColor="#5341CD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Add to Favorites Star Button -->
            <ImageButton
                android:id="@+id/btn_add_to_fav"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_frosted_circle"
                android:contentDescription="@string/cd_add_favorite"
                android:padding="8dp"
                android:src="@drawable/ic_star_outline"
                app:tint="#F59E0B" />

            <!-- Delete from History Button -->
            <ImageButton
                android:id="@+id/btn_remove_history"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_frosted_circle"
                android:contentDescription="@string/cd_delete"
                android:padding="8dp"
                android:src="@drawable/ic_trash"
                app:tint="#94A3B8" />
        </LinearLayout>

        <!-- Explanation Snippet -->
        <TextView
            android:id="@+id/history_snippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/font_nunito_sans"
            android:textColor="#475569"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- In-Sentence Role Container -->
        <LinearLayout
            android:id="@+id/history_role_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/history_in_sentence_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_nunito_sans"
                android:textColor="#475569"
                android:textSize="12sp"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Footer Action Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="Tap to explore AI overview"
                android:textColor="#5341CD"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="#5341CD" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
