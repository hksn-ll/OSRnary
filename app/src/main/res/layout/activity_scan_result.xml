<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 1. The Screen Capture Background -->
    <ImageView
        android:id="@+id/screenshot_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/cd_screenshot"
        android:scaleType="fitCenter" />

    <!-- 2. Interactive Text Highlight Layer -->
    <com.example.gabai.TextOverlayView
        android:id="@+id/text_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. Subtle Dark Vignette Overlay for Focus & Contrast -->
    <View
        android:id="@+id/vignette_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scan_vignette"
        android:clickable="false"
        android:focusable="false" />

    <!-- 4. Animated Cyber Scanning Laser Sweep -->
    <FrameLayout
        android:id="@+id/scanner_laser_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <View
            android:id="@+id/scanner_laser_sweep"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_scanner_laser_beam"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <!-- 5. Top Header with Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp">

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="Close Scanner"
            android:elevation="6dp"
            android:padding="12dp"
            android:src="@drawable/ic_close_bold"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 5. Floating Interactive HUD / Instruction Card -->
    <LinearLayout
        android:id="@+id/instruction_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="96dp"
        android:clickable="false"
        android:elevation="8dp"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_instruction_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_instruction_hud"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/iv_hud_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Scanner"
                android:src="@drawable/ic_center_focus"
                app:tint="#818CF8" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/instruction_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="Tap any word to analyze"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="Or drag across to select a phrase"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Animated Down Hint Chevron -->
        <ImageView
            android:id="@+id/iv_hud_bounce_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:alpha="0.85"
            android:contentDescription="Look Down"
            android:src="@drawable/ic_expand_more"
            app:tint="#818CF8" />
    </LinearLayout>

    <!-- 6. Floating Selection Bottom Card (Draggable / Interactive) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/result_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:clickable="true"
        android:elevation="14dp"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="14dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <!-- Top Drag Handle -->
            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill_translucent"
                android:backgroundTint="#CBD5E1" />

            <!-- Row with Selection Mode Badge and Hint -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_selection_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_role_tab_container"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="TARGET WORD"
                    android:textColor="#5341CD"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="Swipe up to reposition"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Target Word / Phrase Title -->
            <TextView
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:maxLines="2"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="photosynthesis" />

            <!-- Surrounding Sentence Preview Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_role_tab_container"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/card_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/font_nunito_sans"
                    android:maxLines="2"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    tools:text="Plants convert light energy through photosynthesis into chemical energy." />
            </LinearLayout>

            <!-- Call-to-Action Button -->
            <Button
                android:id="@+id/btn_analyze_action"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_gradient_scan"
                android:elevation="0dp"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="Explain with GabAI  →"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>