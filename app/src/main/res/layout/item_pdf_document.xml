<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Stitch.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Modern Document Cover Frame -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="60dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="#F8FAFC"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/img_pdf_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_menu_book"
                app:tint="#6366F1"
                android:contentDescription="@string/cd_pdf_thumbnail" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_pdf_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document Title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_uploader_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded by Teacher"
                android:textSize="12.5sp"
                android:textColor="#64748B"
                android:fontFamily="@font/font_nunito_sans"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8"
            android:layout_marginStart="8dp"
            android:contentDescription="@null" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>