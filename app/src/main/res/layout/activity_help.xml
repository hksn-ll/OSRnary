<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_app_aurora"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.gabai.FastBlurView
        android:id="@+id/blur_header_help"
        android:background="@drawable/bg_glass_blur_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/help_header"
            android:background="@android:color/transparent"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">
            <ImageButton
                android:id="@+id/btn_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                app:tint="@color/text_primary"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help &amp; Guides"
                    android:fontFamily="@font/font_plus_jakarta_sans"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Feature walkthroughs and tutorials"
                    android:fontFamily="@font/font_nunito_sans"/>
            </LinearLayout>
        </LinearLayout>
    </com.example.gabai.FastBlurView>
    <com.example.gabai.FastBlurTarget
        android:id="@+id/blur_target_help"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_help_content"
            android:paddingLeft="16dp"
            android:paddingTop="84dp"
            android:paddingRight="16dp"
            android:paddingBottom="48dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_tabs_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#f1f5f9"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:contentPadding="4dp"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/tab_students"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            app:cardBackgroundColor="#ffffff"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            style="@style/Widget.Material3.CardView.Filled">
                            <TextView
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#5341cd"
                                android:layout_gravity="center"
                                android:id="@+id/tv_tab_students"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Student Guides"
                                android:fontFamily="@font/font_plus_jakarta_sans"/>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/tab_teachers"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            style="@style/Widget.Material3.CardView.Filled">
                            <TextView
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#64748b"
                                android:layout_gravity="center"
                                android:id="@+id/tv_tab_teachers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Teacher Guides"
                                android:fontFamily="@font/font_plus_jakarta_sans"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_replay_student_intro"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#ffffff"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#c7d2fe"
                    app:strokeWidth="1.5dp"
                    style="@style/Widget.Material3.CardView.Filled">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:background="@drawable/bg_pill_translucent"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="#ede9fe">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_gabai_logo"
                                android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:textSize="14.5sp"
                                android:textStyle="bold"
                                android:textColor="#1e1b4b"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Replay Introduction"
                                android:fontFamily="@font/font_plus_jakarta_sans"/>
                            <TextView
                                android:textSize="11.5sp"
                                android:textColor="#64748b"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Watch the animated visual walkthrough of GabAI"
                                android:fontFamily="@font/font_nunito_sans"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_translucent"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Replay  ▶"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:backgroundTint="#5341cd"
                            android:paddingHorizontal="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:paddingHorizontal="4dp">
                    <TextView
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#64748b"
                        android:id="@+id/tv_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STUDENT GUIDES"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:letterSpacing="0.08"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#334155"
                        android:id="@+id/tv_section_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tap any guide to see where it is and how to use it."
                        android:fontFamily="@font/font_nunito_sans"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_help_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.example.gabai.FastBlurTarget>
</androidx.constraintlayout.widget.ConstraintLayout>
