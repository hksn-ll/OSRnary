<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_favorite_root"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EDF2F7"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/item_click_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="false"
        android:focusable="false">

        <!-- Top Row: Title / POS / Date + Trash Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="false"
            android:focusable="false">

            <!-- Title & Metadata -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="false"
                    android:focusable="false">

                    <TextView
                        android:id="@+id/fav_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:maxLines="1"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:clickable="false"
                        android:focusable="false"
                        tools:text="Vocabulary" />

                    <TextView
                        android:id="@+id/fav_pos_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pos_pill"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="#4F46E5"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:clickable="false"
                        android:focusable="false"
                        tools:text="NOUN" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fav_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/font_nunito_sans"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:clickable="false"
                    android:focusable="false"
                    tools:text="Oct 4, 2026" />
            </LinearLayout>

            <com.example.gabai.GabAiLoadingView
                android:id="@+id/fav_card_loading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_remove_fav"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_frosted_circle"
                android:contentDescription="@string/cd_delete"
                android:padding="8dp"
                android:src="@drawable/ic_trash"
                app:tint="#94A3B8" />
        </LinearLayout>

        <!-- Markdown Definition Body -->
        <TextView
            android:id="@+id/fav_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/font_nunito_sans"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="#475569"
            android:textSize="13.5sp"
            android:clickable="false"
            android:focusable="false"
            tools:text="Definition text here..." />

        <!-- In-Sentence Role Container -->
        <LinearLayout
            android:id="@+id/fav_role_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pos_pill"
            android:backgroundTint="#F8FAFC"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="ROLE: "
                android:textColor="#6366F1"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/fav_in_sentence_role"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/font_nunito_sans"
                android:maxLines="1"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:clickable="false"
                android:focusable="false"
                tools:text="Direct object" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
