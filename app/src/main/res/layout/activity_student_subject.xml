<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora">

    <!-- Sticky Glass Header Bar -->
    <com.example.gabai.FastBlurView
        android:id="@+id/blur_header_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/subject_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_blur_top"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:contentDescription="@string/cd_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E293B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LESSON MATERIALS"
                    android:textColor="#6366F1"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tv_subject_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Subject Title"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:letterSpacing="-0.02" />
            </LinearLayout>
        </LinearLayout>
    </com.example.gabai.FastBlurView>

    <!-- Frosted Blur Target Content -->
    <com.example.gabai.FastBlurTarget
        android:id="@+id/blur_target_subject"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_subject"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="84dp"
            android:paddingBottom="48dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/pdf_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </com.example.gabai.FastBlurTarget>

</androidx.constraintlayout.widget.ConstraintLayout>