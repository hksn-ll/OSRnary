<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora">

    <!-- Sticky Glass Header Bar -->
    <com.example.gabai.FastBlurView
        android:id="@+id/blur_header_manage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_blur_top"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/manage_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:contentDescription="@string/cd_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E293B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EDUCATOR PORTAL"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#6366F1"
                    android:fontFamily="@font/font_plus_jakarta_sans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Class Sections"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:letterSpacing="-0.02" />
            </LinearLayout>
        </LinearLayout>
    </com.example.gabai.FastBlurView>

    <!-- Frosted Blur Target Content -->
    <com.example.gabai.FastBlurTarget
        android:id="@+id/blur_target_manage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_container">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_manage_classes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="96dp"
            android:paddingBottom="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/requests_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MY ACTIVE CLASSES"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/classes_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.example.gabai.FastBlurTarget>

    <!-- Floating Ergonomic Action Dock -->
    <LinearLayout
        android:id="@+id/bottom_action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_blur_top"
        android:elevation="16dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_class"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="+ Create New Section"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:background="@drawable/btn_gradient_stitch"
            app:backgroundTint="@null"
            app:cornerRadius="16dp"
            app:elevation="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>