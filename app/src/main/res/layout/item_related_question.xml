<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_question"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/ll_question_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_question_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Why does this process require sunlight?" />

        <ProgressBar
            android:id="@+id/progress_question"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:indeterminateTint="#6C5CE7"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_question_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_expand_more"
            app:tint="#64748B" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_answer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#EDF2F7" />

        <TextView
            android:id="@+id/tv_question_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_nunito_sans"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#334155"
            android:textSize="14sp"
            tools:text="Sunlight energizes chlorophyll molecules, initiating the light-dependent reactions." />
    </LinearLayout>
</LinearLayout>
