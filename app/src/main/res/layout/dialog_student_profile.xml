<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_stitch_card"
    android:paddingLeft="20dp"
    android:paddingTop="12dp"
    android:paddingRight="20dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_translucent"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#cbd5e1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <FrameLayout
            android:id="@+id/frame_profile_avatar"
            android:background="@drawable/bg_bento_purple"
            android:layout_width="60dp"
            android:layout_height="60dp">
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#5341cd"
                android:layout_gravity="center"
                android:id="@+id/tv_profile_monogram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
            <ImageView
                android:id="@+id/iv_profile_photo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0f172a"
                android:id="@+id/tv_profile_full_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#5341cd"
                    android:id="@+id/tv_profile_class_badge"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grade 10 - Emerald"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:backgroundTint="#eef2ff"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#d97706"
                    android:id="@+id/tv_profile_rank_pill"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 #1 Rank"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#fef3c7"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:id="@+id/tv_profile_mastery_pill"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Advanced"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#d1fae5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#4338ca"
                    android:id="@+id/tv_profile_phil_iri_pill"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phil-IRI: Independent"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#e0e7ff"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:baselineAligned="false">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_translucent"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#f8fafc">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5341cd"
                android:id="@+id/tv_stat_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450 XP"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL XP"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:letterSpacing="0.05"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_translucent"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:backgroundTint="#f8fafc"
            android:layout_marginHorizontal="3dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#e11d48"
                android:id="@+id/tv_stat_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 5 Days"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREAK"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:letterSpacing="0.05"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_translucent"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#f8fafc">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#10b981"
                android:id="@+id/tv_stat_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lvl 4"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPLORER"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Literacy & Vocabulary Retention Bento Grid -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:baselineAligned="false">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_translucent"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#f8fafc">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5341cd"
                android:id="@+id/tv_stat_words_mastered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Words"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORDS MASTERED"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:letterSpacing="0.05"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_translucent"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="#f8fafc">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:id="@+id/tv_stat_accuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUIZ ACCURACY"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1e293b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Recall Mastery Benchmark"
        android:fontFamily="@font/font_plus_jakarta_sans"/>
    <LinearLayout
        android:id="@+id/layout_max_combo_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_translucent"
        android:backgroundTint="#F8FAFC">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="⚡"
            android:textSize="22sp"
            android:background="@drawable/bg_pill_translucent"
            android:backgroundTint="#EEF2FF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX RECALL QUIZ COMBO"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="@font/font_plus_jakarta_sans"/>

            <TextView
                android:id="@+id/tv_profile_max_combo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x Combo"
                android:textColor="#4F46E5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_plus_jakarta_sans"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_profile_combo_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peak Streak 🔥"
            android:textColor="#D97706"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_pill_translucent"
            android:backgroundTint="#FEF3C7"
            android:fontFamily="@font/font_plus_jakarta_sans"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1e293b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Achievement Showcase"
        android:fontFamily="@font/font_plus_jakarta_sans"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_trophy_showcase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#5341cd"
            android:id="@+id/btn_share_profile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:text="Share Slip 📤"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:backgroundTint="#EEF2FF"
            app:cornerRadius="14dp"
            app:strokeWidth="1.2dp"
            app:strokeColor="#C7D2FE"
            app:icon="@drawable/ic_share"
            app:iconTint="#5341CD"
            app:iconSize="16dp"
            app:iconPadding="4dp"
            style="@style/Widget.Material3.Button.TonalButton"/>

        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btn_close_sheet"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:text="Close"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:backgroundTint="#5341cd"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button"/>
    </LinearLayout>
</LinearLayout>
