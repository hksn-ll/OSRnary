<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ================= TOP HEADER & STORY PROGRESS TRACK ================= -->
    <LinearLayout
        android:id="@+id/header_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand & Chapter Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gabai_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:letterSpacing="-0.02"
                        android:text="GabAI"
                        android:textColor="#0F172A"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_intro_chapter_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_translucent"
                        android:backgroundTint="#EEF2FF"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="OVERVIEW"
                        android:textColor="#5341CD"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_intro_step_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/font_nunito_sans"
                    android:text="Interactive Feature Tour • Step 1 of 5"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_intro_skip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill_translucent"
                android:backgroundTint="#E6FFFFFF"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Skip Tour"
                android:textColor="#475569"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5-Segment Story Progress Bar -->
        <LinearLayout
            android:id="@+id/ll_story_segments"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- ================= SLIDE VIEWPAGER ================= -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_intro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/bottom_panel_intro"
        app:layout_constraintTop_toBottomOf="@+id/header_intro" />

    <!-- ================= FLOATING GLASS BOTTOM DOCK ================= -->
    <LinearLayout
        android:id="@+id/bottom_panel_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/dock_card_intro"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/bg_intro_glass_dock"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/btn_intro_prev"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_translucent"
                android:backgroundTint="#F1F5F9"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:gravity="center"
                android:minWidth="74dp"
                android:paddingHorizontal="14dp"
                android:text="← Back"
                android:textColor="#475569"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/ll_dots_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/btn_intro_next"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_gradient_quest"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:gravity="center"
                android:minWidth="128dp"
                android:paddingHorizontal="18dp"
                android:text="Continue  →"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
