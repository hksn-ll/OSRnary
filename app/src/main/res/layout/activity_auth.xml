<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/auth_main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="56dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- ================= APP LOGO & BRAND HEADER ================= -->
        <ImageView
            android:id="@+id/iv_auth_brand_logo"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gabai_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GabAI"
            android:textColor="#5341CD"
            android:textSize="28sp"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:text="AI Reading &amp; Learning Companion"
            android:textColor="#64748B"
            android:fontFamily="@font/font_nunito_sans"
            android:textSize="13sp" />

        <!-- ================= STITCH ELEVATED CARD ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_auth_container"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="6dp"
            app:cardUseCompatPadding="false"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EDF2F7"
            app:contentPadding="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:id="@+id/card_inner_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingVertical="26dp">

                <!-- ================= SEGMENTED ROLE SWITCHER (PILL) ================= -->
                <LinearLayout
                    android:id="@+id/container_role_switcher"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_role_tab_container"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:layout_marginBottom="20dp">

                    <!-- Student Tab -->
                    <TextView
                        android:id="@+id/btn_tab_student"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/bg_role_tab_indicator"
                        android:text="🎓  Student"
                        android:textColor="#5341CD"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Educator Tab -->
                    <TextView
                        android:id="@+id/btn_tab_teacher"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@android:color/transparent"
                        android:text="🍎  Educator"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- ================= GREETING / HEADER ================= -->
                <LinearLayout
                    android:id="@+id/container_greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/tv_auth_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back! 👋"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_role_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Enter your credentials to continue reading."
                        android:textColor="#64748B"
                        android:fontFamily="@font/font_nunito_sans"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Legacy container_role placeholder kept invisible for API safety -->
                <LinearLayout
                    android:id="@+id/container_role"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <Button android:id="@+id/btn_role_student" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <Button android:id="@+id/btn_role_teacher" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                </LinearLayout>

                <!-- ================= LOGIN FORM CONTAINER ================= -->
                <LinearLayout
                    android:id="@+id/container_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Username / Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_login_email"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="#94A3B8"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_login_email"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Username"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:paddingVertical="0dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="16dp"
                            android:gravity="center_vertical"
                            android:inputType="text"
                            android:imeOptions="actionNext"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_login_password"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#94A3B8"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#94A3B8"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_login_password"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Password"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:paddingVertical="0dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="16dp"
                            android:gravity="center_vertical"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Forgot Password Link (Teacher only) -->
                    <TextView
                        android:id="@+id/tv_forgot_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp"
                        android:padding="4dp"
                        android:text="Forgot Password?"
                        android:textColor="#5341CD"
                        android:textSize="13sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Student Helper Banner -->
                    <LinearLayout
                        android:id="@+id/container_student_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_banner_student"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_school"
                            app:tint="#5341CD" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Student accounts are provisioned by your classroom teacher. Use your assigned credentials."
                            android:textColor="#4338CA"
                            android:textSize="12sp"
                            android:fontFamily="@font/font_nunito_sans"
                            android:lineSpacingMultiplier="1.15" />
                    </LinearLayout>

                    <!-- Sign In CTA Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login_submit"
                        android:layout_width="match_parent"
                        android:layout_height="73dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/btn_gradient_stitch"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:letterSpacing="0.01"
                        android:outlineAmbientShadowColor="#5341CD"
                        android:outlineSpotShadowColor="#5341CD"
                        android:text="Sign In  ➔"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="18dp"
                        app:elevation="6dp" />

                    <!-- Teacher Register Link -->
                    <TextView
                        android:id="@+id/tv_go_to_register"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:minHeight="@dimen/touch_target_min"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="New Educator? Create an Account"
                        android:textColor="#5341CD"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_back_to_roles"
                        style="@style/Widget.GabAI.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Change Role / Go Back"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ================= REGISTER FORM CONTAINER (EDUCATOR) ================= -->
                <LinearLayout
                    android:id="@+id/container_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Back to Sign In Row -->
                    <LinearLayout
                        android:id="@+id/btn_reg_back_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="#5341CD" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Back to Sign In"
                            android:textColor="#5341CD"
                            android:textSize="14sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Educator Registration"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Create an account to manage your classes and library."
                        android:textColor="#64748B"
                        android:fontFamily="@font/font_nunito_sans"
                        android:textSize="13sp" />

                    <!-- Verification Notice Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_banner_educator"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_verified_teal" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Educator accounts undergo administrative verification before activation."
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:fontFamily="@font/font_nunito_sans"
                            android:lineSpacingMultiplier="1.15" />
                    </LinearLayout>

                    <!-- 2-Column Names Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            app:boxBackgroundColor="#F8FAFC"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeColor="#E2E8F0"
                            app:boxStrokeWidthFocused="1.5dp"
                            app:startIconDrawable="@drawable/ic_person"
                            app:startIconTint="#94A3B8"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_reg_firstname"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:hint="First Name"
                                android:textColor="#0F172A"
                                android:textColorHint="#94A3B8"
                                android:textSize="13sp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:paddingVertical="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="12dp"
                                android:gravity="center_vertical"
                                android:inputType="textPersonName|textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            app:boxBackgroundColor="#F8FAFC"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeColor="#E2E8F0"
                            app:boxStrokeWidthFocused="1.5dp"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_reg_lastname"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:hint="Last Name"
                                android:textColor="#0F172A"
                                android:textColorHint="#94A3B8"
                                android:textSize="13sp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:paddingVertical="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp"
                                android:gravity="center_vertical"
                                android:inputType="textPersonName|textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- School Dropdown -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:startIconDrawable="@drawable/ic_school"
                        app:startIconTint="#94A3B8"
                        app:endIconTint="#94A3B8"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/spinner_school"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Select School"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="13sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:paddingVertical="0dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:gravity="center_vertical"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:startIconDrawable="@drawable/ic_mail"
                        app:startIconTint="#94A3B8"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_reg_email"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Official School Email Address"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="13sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:paddingVertical="0dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:gravity="center_vertical"
                            android:inputType="textEmailAddress"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#94A3B8"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#94A3B8"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_reg_password"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Create Password"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="13sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:paddingVertical="0dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:gravity="center_vertical"
                            android:inputType="textPassword"
                            android:imeOptions="actionNext"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_reg_confirm_password"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#94A3B8"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#94A3B8"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_reg_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Confirm Password"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="13sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:paddingVertical="0dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:gravity="center_vertical"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Micro Password Rule Info -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Must contain at least 8 characters, one number, and a symbol."
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:fontFamily="@font/font_nunito_sans"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Hidden legacy fallback views for student registration compatibility -->
                    <RadioGroup
                        android:id="@+id/rg_register_role"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">
                        <RadioButton android:id="@+id/rb_student" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <RadioButton android:id="@+id/rb_teacher" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                    </RadioGroup>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_reg_grade"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">
                        <AutoCompleteTextView android:id="@+id/spinner_grade" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_reg_section"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_reg_section" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Register Submit CTA -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_register_submit"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:background="@drawable/btn_gradient_stitch"
                        app:backgroundTint="@null"
                        android:text="Create Educator Account  ➔"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        app:cornerRadius="18dp"
                        app:elevation="6dp"
                        android:outlineAmbientShadowColor="#5341CD"
                        android:outlineSpotShadowColor="#5341CD" />

                    <TextView
                        android:id="@+id/tv_go_to_login"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:minHeight="@dimen/touch_target_min"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="Already have an account? Sign In"
                        android:textColor="#5341CD"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ================= LOADING SPINNER (FALLBACK) ================= -->
                <LinearLayout
                    android:id="@+id/container_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="32dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:indeterminateTint="#5341CD" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Connecting to GabAI..."
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_nunito_sans"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>