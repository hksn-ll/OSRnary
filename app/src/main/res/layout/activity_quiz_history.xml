<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora">

    <!-- Frosted Glass Top Bar Header -->
    <LinearLayout
        android:id="@+id/history_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_top_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="42dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:contentDescription="@string/cd_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_frosted_circle"
            android:src="@drawable/ic_arrow_back"
            app:tint="#161D1F" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSESSMENT ARCHIVE"
                android:textColor="#5341CD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quiz History"
                android:textColor="#161D1F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_plus_jakarta_sans" />
        </LinearLayout>
    </LinearLayout>

    <!-- List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/history_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/quiz_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>