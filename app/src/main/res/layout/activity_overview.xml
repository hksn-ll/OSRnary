<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true">

    <!-- ================================================================= -->
    <!-- NATIVE HEADER TOOLBAR                                             -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:text="AI Overview"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save to favorites"
            android:padding="8dp"
            android:src="@drawable/ic_star_outline"
            app:tint="#F1C40F" />
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- SCROLLABLE CONTENT BODY                                           -->
    <!-- ================================================================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="48dp">

            <!-- ========================================================= -->
            <!-- 1. HERO PASSAGE CONTEXT CARD (Matching fragment_home.xml)  -->
            <!-- ========================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sentence_context"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_xp_gradient"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_context_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_translucent"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="IN-SENTENCE CONTEXT"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ProgressBar
                            android:id="@+id/progress_tts_selected"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Surrounding Sentence with Highlighted Target Word -->
                    <TextView
                        android:id="@+id/selected_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/font_nunito_sans"
                        android:lineSpacingMultiplier="1.35"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        tools:text="Plants absorb sunlight using chlorophyll inside chloroplasts to synthesize organic compounds." />

                    <!-- Pronunciation Audio Pill Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Listen to Word -->
                        <LinearLayout
                            android:id="@+id/btn_speak_word"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_translucent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_volume_up"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:id="@+id/tv_btn_speak_word"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:text="Word"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Listen to Sentence -->
                        <LinearLayout
                            android:id="@+id/btn_speak_sentence"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_translucent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_volume_up"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:text="Sentence"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Legacy hidden button alias for backwards compatibility -->
                        <ImageButton
                            android:id="@+id/btn_speak_selected"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:contentDescription="Legacy speak alias" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================================= -->
            <!-- 2. LOADING STATE INDICATOR                                -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/loading_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="36dp"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="#6C5CE7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="Synthesizing context..."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- 3. RESULT CONTAINER (Primary Definition, Qs, Visuals)     -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- PRIMARY EXPLANATION CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_primary_explanation"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="#EDF2F7"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Word Header, Phonetics, POS, Speak -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_target_word"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/font_plus_jakarta_sans"
                                        android:textColor="#0F172A"
                                        android:textSize="22sp"
                                        android:textStyle="bold"
                                        tools:text="chloroplasts" />

                                    <TextView
                                        android:id="@+id/tv_part_of_speech"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:background="@drawable/bg_role_tab_container"
                                        android:fontFamily="@font/font_plus_jakarta_sans"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="3dp"
                                        android:textColor="#5341CD"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        tools:text="NOUN" />

                                    <TextView
                                        android:id="@+id/tv_language_badge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:background="@drawable/bg_role_tab_container"
                                        android:foreground="?attr/selectableItemBackground"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:fontFamily="@font/font_plus_jakarta_sans"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="3dp"
                                        android:textColor="#059669"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        tools:text="🌐 English ▾" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_phonetics"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/font_nunito_sans"
                                    android:textColor="#64748B"
                                    android:textSize="13sp"
                                    tools:text="/ˈklɔːr.ə.plæst/" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/progress_tts_explanation"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:indeterminateTint="#6C5CE7"
                                android:visibility="gone" />

                            <ImageButton
                                android:id="@+id/btn_speak_explanation"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Speak explanation"
                                android:padding="8dp"
                                android:src="@drawable/ic_volume_up"
                                app:tint="#5341CD" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="14dp"
                            android:background="#EDF2F7" />

                        <!-- Main Definition Text -->
                        <TextView
                            android:id="@+id/ai_result_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_nunito_sans"
                            android:lineSpacingMultiplier="1.35"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            tools:text="Specialized organelles found in green plant cells that conduct photosynthesis, converting light energy into chemical energy." />

                        <!-- Role In Sentence Context Box -->
                        <LinearLayout
                            android:id="@+id/ll_in_sentence_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_input_field"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tv_in_sentence_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:letterSpacing="0.06"
                                android:text="ROLE IN THIS SENTENCE"
                                android:textColor="#5341CD"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_in_sentence"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/font_nunito_sans"
                                android:lineSpacingMultiplier="1.3"
                                android:textColor="#334155"
                                android:textSize="13sp"
                                tools:text="Functions as the cellular site where chlorophyll captures sunlight to drive the reaction." />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================================= -->
                <!-- 4. RELATED QUESTIONS SECTION (PLACED BEFORE VISUALS)      -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:id="@+id/container_related_questions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:letterSpacing="0.08"
                            android:text="RELATED QUESTIONS"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/font_nunito_sans"
                            android:text="• Tap to explore"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Vertically Stacked Related Questions Container -->
                    <LinearLayout
                        android:id="@+id/ll_related_questions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- ========================================================= -->
                <!-- 5. VISUAL CONTEXT SECTION (PLACED AFTER QUESTIONS)        -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:id="@+id/visuals_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Header Row with badge and fullscreen expand button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:letterSpacing="0.08"
                            android:text="VISUAL CONTEXT"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_visual_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_role_tab_container"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="VISUAL CONTEXT"
                            android:textColor="#5341CD"
                            android:textSize="10sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btn_fullscreen_visual"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Fullscreen visual"
                            android:padding="6dp"
                            android:src="@drawable/ic_fullscreen"
                            app:tint="#64748B" />
                    </LinearLayout>

                    <!-- Perspective Filter Chips (Universal for Literature, History, Science, Math, etc.) -->
                    <LinearLayout
                        android:id="@+id/ll_visual_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/chip_diagram"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_selected"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Overview"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chip_microscopic"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Real-World"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chip_process"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Diagrams &amp; Charts"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Card Frame with Curated Diagram ImageView and fallback WebView -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_visual_frame"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:contentPadding="0dp"
                        app:strokeColor="#EDF2F7"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <!-- Web search view (used when in search mode or fallback) -->
                            <WebView
                                android:id="@+id/image_webview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <!-- Native Curated Diagram Layout -->
                            <LinearLayout
                                android:id="@+id/container_curated_diagram"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:background="#FAFCFF">

                                <ImageView
                                    android:id="@+id/iv_curated_diagram"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:scaleType="fitCenter"
                                    android:padding="8dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Curated Educational Diagram" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#FFFFFF"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="8dp"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:id="@+id/tv_diagram_caption"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/font_nunito_sans"
                                        android:maxLines="1"
                                        android:ellipsize="end"
                                        android:textColor="#334155"
                                        android:textSize="12sp"
                                        tools:text="Visual context overview" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:fontFamily="@font/font_plus_jakarta_sans"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp"
                                        android:text="Wikimedia Commons" />
                                </LinearLayout>
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/progress_visual"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="#6C5CE7"
                                android:visibility="gone" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>