<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Squircle Avatar with Rounded Border -->
        <FrameLayout
            android:id="@+id/frame_student_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_squircle_border"
            android:clipToOutline="true"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tv_student_avatar_monogram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textColor="#5341CD"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="👤" />

            <ImageView
                android:id="@+id/iv_student_avatar_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Student Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Juan Cruz"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/tv_student_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:text="Unclaimed"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#B45309"
                    android:background="@drawable/bg_pill_amber_subtle"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tv_student_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="User: juancruz_102 | Pass: gab5634"
                    android:textSize="12sp"
                    android:textColor="#64748B" />

                <ImageButton
                    android:id="@+id/btn_toggle_pass"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="#64748B"
                    android:visibility="gone"
                    android:contentDescription="Toggle Password Visibility" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <ImageButton
            android:id="@+id/btn_copy_student"
            android:contentDescription="Copy Credentials"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_copy"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#5341CD"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_edit_student"
            android:contentDescription="@string/cd_edit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#5341CD"
            android:layout_marginEnd="2dp" />

        <ImageButton
            android:id="@+id/btn_delete_student"
            android:contentDescription="@string/cd_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_trash"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#EF4444" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>