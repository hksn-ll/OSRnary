<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F4F6F8">

    <LinearLayout
        android:id="@+id/pdf_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_close_pdf"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#2D3436"
            android:contentDescription="Close"/>

        <TextView
            android:id="@+id/tv_pdf_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="#2D3436"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"/>

        <ImageButton
            android:id="@+id/btn_kebab_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_meatballs"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#2D3436"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pdf_loading_bar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="#6C5CE7"
        app:layout_constraintTop_toBottomOf="@id/pdf_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.github.barteksc.pdfviewer.PDFView
        android:id="@+id/online_pdf_viewer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pdf_header"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <LinearLayout
        android:id="@+id/pdf_action_loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="#6C5CE7"/>

        <TextView
            android:id="@+id/tv_action_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2D3436"
            android:text="Processing..."
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>