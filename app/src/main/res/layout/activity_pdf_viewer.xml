<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Online PDF Viewer wrapped in FastBlurTarget for top bar backdrop blur -->
    <com.example.gabai.FastBlurTarget
        android:id="@+id/blur_target_pdf"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/online_pdf_viewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </com.example.gabai.FastBlurTarget>

    <com.example.gabai.GabAiLoadingView
        android:id="@+id/pdf_loading_bar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Glassmorphic Reader Top Bar (Floating Overlaid Header) -->
    <com.example.gabai.FastBlurView
        android:id="@+id/blur_header_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_blur_top"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/pdf_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_close_pdf"
                android:contentDescription="@string/cd_close"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_close_bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E293B" />

            <TextView
                android:id="@+id/tv_pdf_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btn_kebab_menu"
                android:contentDescription="@string/cd_menu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_meatballs"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E293B" />
        </LinearLayout>
    </com.example.gabai.FastBlurView>

    <!-- Floating Ergonomic Bottom Reading Dock -->
    <LinearLayout
        android:id="@+id/bottom_reading_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Page Indicator Pill -->
        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_translucent"
            android:backgroundTint="#EE1E293B"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="1 / 1"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Quick Quiz Launch Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bottom_quiz_action"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="📝 Take Quiz"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:background="@drawable/btn_gradient_stitch"
            app:backgroundTint="@null"
            app:cornerRadius="23dp"
            app:elevation="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pdf_action_loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">
        <com.example.gabai.GabAiLoadingView android:layout_width="56dp" android:layout_height="56dp"/>
        <TextView android:id="@+id/tv_action_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Processing..." android:layout_marginTop="12dp" android:fontFamily="@font/font_plus_jakarta_sans" android:textStyle="bold"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>