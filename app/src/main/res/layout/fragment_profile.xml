<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_student_avatar"
            android:scaleType="centerInside"
            android:elevation="0dp"/>

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading Name..."
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2D3436"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tv_profile_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@school.ph"
            android:textSize="14sp"
            android:textColor="#636E72"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_quiz"
            android:backgroundTint="#FFFFFF"
            android:padding="24dp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Academic Info 🎓"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2D3436"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_profile_school"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="School: -"
                android:textSize="16sp"
                android:textColor="#2D3436"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_profile_grade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grade: -"
                android:textSize="16sp"
                android:textColor="#2D3436"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_profile_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Section: -"
                android:textSize="16sp"
                android:textColor="#2D3436"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_preferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_quiz"
            android:backgroundTint="#FFFFFF"
            android:padding="24dp"
            android:elevation="2dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Preferences ⚙️"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2D3436"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_language_selector"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                android:hint="AI Explanation Language">

                <AutoCompleteTextView
                    android:id="@+id/actv_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <Button
                android:id="@+id/btn_report_bug"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Report a Bug 🐛"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#DFE6E9"
                android:textColor="#2D3436"
                app:cornerRadius="16dp"
                android:elevation="2dp"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Sign Out 🚪"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FFEAA7"
            android:textColor="#D63031"
            app:cornerRadius="16dp"
            android:elevation="2dp"/>

    </LinearLayout>
</ScrollView>