<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/assessment_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_close_assessment"
            android:contentDescription="Close Assessment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="WEEKLY ASSESSMENT"
                android:textColor="#E4DFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="Reading Assessment"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- 1. ACTIVE QUIZ RUNNER (Displayed during quiz)                      -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/layout_quiz_runner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Progress Bar and Step Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_progress_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="Question 1 of 10"
                    android:textColor="#5341CD"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="10%"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_quiz"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="10"
                android:progress="1"
                android:progressTint="#6C5CE7"
                android:progressBackgroundTint="#E2E8F0" />
        </LinearLayout>

        <!-- Question and Options Scrollable Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Question Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EDF2F7"
                    app:contentPadding="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_question_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_level_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="QUESTION 1"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_question_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:lineSpacingMultiplier="1.25"
                            android:text="What is the primary function of chlorophyll in plant cells during photosynthesis?"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Options List (Cards 0 to 3) -->
                <LinearLayout
                    android:id="@+id/options_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Option 0 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_opt_0"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="#EDF2F7"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/badge_opt_0"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_input_field"
                                android:gravity="center"
                                android:text="A"
                                android:textColor="#5341CD"
                                android:textSize="13sp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_opt_0"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:fontFamily="@font/font_nunito_sans"
                                android:text="Absorb sunlight and convert light energy into chemical energy"
                                android:textColor="#1E293B"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Option 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_opt_1"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="#EDF2F7"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/badge_opt_1"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_input_field"
                                android:gravity="center"
                                android:text="B"
                                android:textColor="#5341CD"
                                android:textSize="13sp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_opt_1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:fontFamily="@font/font_nunito_sans"
                                android:text="Absorb water directly from soil moisture"
                                android:textColor="#1E293B"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Option 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_opt_2"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="#EDF2F7"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/badge_opt_2"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_input_field"
                                android:gravity="center"
                                android:text="C"
                                android:textColor="#5341CD"
                                android:textSize="13sp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_opt_2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:fontFamily="@font/font_nunito_sans"
                                android:text="Store excess glucose in cell vacuoles"
                                android:textColor="#1E293B"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Option 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_opt_3"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="#EDF2F7"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/badge_opt_3"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_input_field"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="#5341CD"
                                android:textSize="13sp"
                                android:fontFamily="@font/font_plus_jakarta_sans"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_opt_3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:fontFamily="@font/font_nunito_sans"
                                android:text="Release carbon dioxide back into the atmosphere"
                                android:textColor="#1E293B"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prev_question"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="← Previous"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#EDF2F7"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_question"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.3"
                android:background="@drawable/btn_gradient_stitch"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="Next Question ➔"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:elevation="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ================================================================= -->
    <!-- 2. INSTANT RESULTS VIEW (Displayed upon submission / review)      -->
    <!-- ================================================================= -->
    <ScrollView
        android:id="@+id/layout_quiz_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Hero Score Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EDF2F7"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_result_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎉"
                        android:textSize="48sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_result_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:text="Assessment Completed!"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_result_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_nunito_sans"
                        android:text="Your responses have been recorded."
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Score Badge Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Score: "
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_final_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9 / 10"
                            android:textColor="#00B894"
                            android:textSize="20sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_final_percentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="#D1FAE5"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="90%"
                            android:textColor="#065F46"
                            android:textSize="13sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- XP Reward -->
                    <TextView
                        android:id="@+id/tv_xp_reward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:text="⭐ +50 Learning XP Awarded"
                        android:textColor="#F59E0B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Review Questions Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question Review &amp; Educational Explanations"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Questions Review List Container -->
            <LinearLayout
                android:id="@+id/results_questions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Done Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish_assessment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_gradient_stitch"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="Back to Dashboard ➔"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:elevation="2dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
