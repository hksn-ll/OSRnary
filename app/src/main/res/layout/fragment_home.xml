<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora"
    android:padding="@dimen/screen_padding">

    <!-- ===== Header ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/profile_ring"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="@dimen/stroke_glass"
        app:cardBackgroundColor="@color/glass_fill_strong"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/profile_image"
            android:contentDescription="@string/cd_profile_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher"
            android:padding="@dimen/space_sm"
            android:clipToOutline="true" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/space_md"
        android:gravity="center_vertical"
        app:layout_constraintStart_toEndOf="@id/profile_ring"
        app:layout_constraintTop_toTopOf="@id/profile_ring"
        app:layout_constraintBottom_toBottomOf="@id/profile_ring"
        app:layout_constraintEnd_toStartOf="@id/bubble_switch">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GabAI"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instant On-Screen Reader"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/bubble_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/touch_target_min"
        android:minHeight="@dimen/touch_target_min"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/profile_ring"
        app:layout_constraintBottom_toBottomOf="@id/profile_ring" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/profile_ring"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello, Student! 👋"
                android:textAppearance="@style/TextAppearance.GabAI.Headline"
                android:layout_marginBottom="@dimen/space_xs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to take a quiz today?"
                android:textAppearance="@style/TextAppearance.GabAI.Body"
                android:layout_marginBottom="@dimen/space_lg" />

            <!-- ===== XP / Level hero (vibrant aurora gradient) ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_card_level"
                android:elevation="@dimen/elevation_hero"
                android:clipToOutline="true"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:id="@+id/unlocked_xp_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding"
                    android:visibility="visible">

                    <TextView android:id="@+id/tv_level_label" android:text="LEVEL 1" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.04" android:textColor="@color/text_on_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tv_xp_label" android:text="0 / 100 XP" android:textSize="12sp" android:textColor="@color/text_on_dark" android:layout_gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <ProgressBar android:id="@+id/xp_progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:progress="0" android:progressDrawable="@drawable/pill_background" android:layout_marginTop="@dimen/space_xs" android:layout_marginBottom="@dimen/space_md" />
                    <TextView android:text="Gain XP by saving words and taking quizzes!" android:textSize="12sp" android:textColor="@color/text_on_dark_muted" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/locked_xp_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/scrim"
                    android:visibility="gone">

                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_secure" app:tint="@color/text_on_dark" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Leveling Locked" android:textStyle="bold" android:textColor="@color/text_on_dark" android:textSize="16sp" android:layout_marginTop="@dimen/space_sm" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complete Apprentice Quests to unlock" android:textColor="@color/text_on_dark_muted" android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== Apprentice Quests board (glass) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quest_board_container"
                style="@style/Widget.GabAI.CardView.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apprentice Quests 📜" android:textAppearance="@style/TextAppearance.GabAI.Title" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Finish these to unlock your rank:" android:textAppearance="@style/TextAppearance.GabAI.Body" android:layout_marginBottom="@dimen/space_md" />

                    <TextView android:id="@+id/quest_bubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 1. Activate the Floating Bubble" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />
                    <TextView android:id="@+id/quest_read" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 2. Read the 4 Required Materials" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />
                    <TextView android:id="@+id/quest_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 3. Pass the Initiation Test" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />
                    <TextView android:id="@+id/quest_scan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 4. Scan a text with the Camera" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />
                    <TextView android:id="@+id/quest_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 5. Save a word to Favorites" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />
                    <TextView android:id="@+id/quest_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 6. Check your Scan History" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />
                    <TextView android:id="@+id/quest_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 7. View Saved Content" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />
                    <TextView android:id="@+id/quest_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 8. Open the Digital Library" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingVertical="@dimen/space_xs" />

                    <Button android:id="@+id/btn_quest_details" style="@style/Widget.GabAI.Button.Gradient" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View Quest Details" android:layout_marginTop="@dimen/space_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Section label ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Journey"
                android:textAppearance="@style/TextAppearance.GabAI.Title"
                android:textSize="16sp"
                android:layout_marginBottom="@dimen/space_sm" />

            <!-- ===== Bento grid: row 1 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Learning Progress -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_learning_progress"
                    style="@style/Widget.GabAI.CardView.Glass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="128dp">
                        <FrameLayout android:layout_width="@dimen/icon_tile" android:layout_height="@dimen/icon_tile" android:background="@drawable/bg_icon_tile_purple">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@android:drawable/ic_media_play" app:tint="@color/brand_primary" android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="Learning Progress" android:textAppearance="@style/TextAppearance.GabAI.Title" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="Level, XP &amp; accuracy" android:textAppearance="@style/TextAppearance.GabAI.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Daily Quests -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_daily_quests"
                    style="@style/Widget.GabAI.CardView.Glass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="128dp">
                        <FrameLayout android:layout_width="@dimen/icon_tile" android:layout_height="@dimen/icon_tile" android:background="@drawable/bg_icon_tile_green">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_today" app:tint="@color/success_green" android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="Daily Quests" android:textAppearance="@style/TextAppearance.GabAI.Title" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="Daily tasks for bonus XP" android:textAppearance="@style/TextAppearance.GabAI.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===== Bento grid: row 2 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- My Badges -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_achievements"
                    style="@style/Widget.GabAI.CardView.Glass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="128dp">
                        <FrameLayout android:layout_width="@dimen/icon_tile" android:layout_height="@dimen/icon_tile" android:background="@drawable/bg_icon_tile_gold">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/accent_gold" android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="My Badges" android:textAppearance="@style/TextAppearance.GabAI.Title" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="Unlocked achievements" android:textAppearance="@style/TextAppearance.GabAI.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Class Leaderboard -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_leaderboard"
                    style="@style/Widget.GabAI.CardView.Glass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="128dp">
                        <FrameLayout android:layout_width="@dimen/icon_tile" android:layout_height="@dimen/icon_tile" android:background="@drawable/bg_icon_tile_blue">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@android:drawable/btn_star_big_on" app:tint="@color/accent_amber" android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="Leaderboard" android:textAppearance="@style/TextAppearance.GabAI.Title" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="Rank in your section" android:textAppearance="@style/TextAppearance.GabAI.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <Button
                android:id="@+id/btn_join_class"
                style="@style/Widget.GabAI.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg"
                android:backgroundTint="@color/success_green"
                android:padding="@dimen/space_md"
                android:text="Join Class with Code"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- ===== Tools section ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tools"
                android:textAppearance="@style/TextAppearance.GabAI.Title"
                android:textSize="16sp"
                android:layout_marginBottom="@dimen/space_sm" />

            <!-- Camera Live Scan (vibrant hero) -->
            <LinearLayout
                android:id="@+id/btn_open_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_level"
                android:elevation="@dimen/elevation_hero"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/space_md"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView android:text="📷  Camera Live Scan" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text_on_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="Scan physical books and documents in real-time" android:textSize="14sp" android:textColor="@color/text_on_dark_muted" android:layout_marginTop="@dimen/space_xs" android:layout_marginBottom="@dimen/space_md" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <Button
                    style="@style/Widget.GabAI.Button.OnCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Scanner"
                    android:clickable="false"
                    android:duplicateParentState="true"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>

            <!-- Digital Library (secondary hero) -->
            <LinearLayout
                android:id="@+id/btn_open_library"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_alt"
                android:elevation="@dimen/elevation_hero"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView android:text="📚  Digital Library" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text_on_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="View and read materials assigned by your teacher" android:textSize="14sp" android:textColor="@color/text_on_dark_muted" android:layout_marginTop="@dimen/space_xs" android:layout_marginBottom="@dimen/space_md" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <Button
                    style="@style/Widget.GabAI.Button.OnCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Library"
                    android:clickable="false"
                    android:duplicateParentState="true"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>

            <!-- ===== Review section ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review &amp; Recall"
                android:textAppearance="@style/TextAppearance.GabAI.Title"
                android:textSize="16sp"
                android:layout_marginBottom="@dimen/space_sm" />

            <!-- Recall Quiz (glass) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GabAI.CardView.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="Recall Quiz" android:textAppearance="@style/TextAppearance.GabAI.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:text="Test your memory on past selected contexts" android:textAppearance="@style/TextAppearance.GabAI.Body" android:layout_marginTop="@dimen/space_xs" android:layout_marginBottom="@dimen/space_md" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_start_quiz" style="@style/Widget.GabAI.Button.Gradient" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start Quiz" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Favourites (glass) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GabAI.CardView.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="Favourites" android:textAppearance="@style/TextAppearance.GabAI.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:text="View your saved texts" android:textAppearance="@style/TextAppearance.GabAI.Body" android:layout_marginTop="@dimen/space_xs" android:layout_marginBottom="@dimen/space_md" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_favs" style="@style/Widget.GabAI.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View Favourites" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- History (glass) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GabAI.CardView.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="History" android:textAppearance="@style/TextAppearance.GabAI.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:text="Review all highlighted text blocks" android:textAppearance="@style/TextAppearance.GabAI.Body" android:layout_marginTop="@dimen/space_xs" android:layout_marginBottom="@dimen/space_md" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_history" style="@style/Widget.GabAI.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View History" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
