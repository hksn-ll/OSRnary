<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <ImageView
        android:id="@+id/profile_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@mipmap/ic_launcher"
        android:background="@drawable/bg_card_level"
        android:padding="8dp"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toEndOf="@id/profile_image"
        app:layout_constraintTop_toTopOf="@id/profile_image"
        app:layout_constraintBottom_toBottomOf="@id/profile_image"
        app:layout_constraintEnd_toStartOf="@id/bubble_switch">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OSRnary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2D3436" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instant On-Screen Reader"
            android:textSize="13sp"
            android:textColor="#636E72" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/bubble_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/profile_image"
        app:layout_constraintBottom_toBottomOf="@id/profile_image"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/profile_image"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello, Student! 👋"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to take a quiz today?"
                android:textSize="14sp"
                android:textColor="#636E72"
                android:layout_marginBottom="24dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_card_level"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/unlocked_xp_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="visible">
                    <TextView android:id="@+id/tv_level_label" android:text="LEVEL 1" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tv_xp_label" android:text="0 / 100 XP" android:textSize="12sp" android:textColor="#FFFFFF" android:layout_gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <ProgressBar android:id="@+id/xp_progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progress="0" android:progressDrawable="@drawable/pill_background" android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>
                    <TextView android:text="Gain XP by saving words and taking quizzes!" android:textSize="12sp" android:textColor="#E0E0E0" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/locked_xp_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#D9000000"
                    android:visibility="gone">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_secure" app:tint="#FFFFFF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Leveling Locked" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="16sp" android:layout_marginTop="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complete Apprentice Quests to unlock" android:textColor="#CCCCCC" android:textSize="12sp"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/quest_board_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_history"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apprentice Quests 📜" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Finish these to unlock your rank:" android:textSize="14sp" android:textColor="#444444" android:layout_marginBottom="16dp"/>

                <TextView android:id="@+id/quest_bubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 1. Activate the Floating Bubble" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>
                <TextView android:id="@+id/quest_read" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 2. Read the 4 Required Materials" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>
                <TextView android:id="@+id/quest_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 3. Pass the Initiation Test" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>
                <TextView android:id="@+id/quest_scan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 4. Scan a text with the Camera" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>
                <TextView android:id="@+id/quest_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 5. Save a word to Favorites" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>
                <TextView android:id="@+id/quest_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 6. Check your Scan History" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>
                <TextView android:id="@+id/quest_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 7. View Saved Content" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>
                <TextView android:id="@+id/quest_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="❌ 8. Open the Digital Library" android:textColor="#000000" android:textSize="15sp" android:paddingVertical="4dp"/>

                <Button android:id="@+id/btn_quest_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View Quest Details" android:layout_marginTop="16dp" android:backgroundTint="#2d3436"/>
            </LinearLayout>

            <!-- Learning Progress Card -->
            <LinearLayout

                android:id="@+id/btn_learning_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_quiz"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:foreground="?attr/selectableItemBackground">

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Learning Progress"
                        android:textColor="#2D3436"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="View your level, XP, and accuracy"
                        android:textColor="#636E72"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Arrow Icon pointing right -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#B2BEC3" />
            </LinearLayout>
            <!-- Daily Quests Card -->
            <LinearLayout
                android:id="@+id/btn_daily_quests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="1dp"
                android:background="@drawable/bg_card_quiz"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Quests"
                        android:textColor="#2D3436"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Complete daily tasks for bonus XP!"
                        android:textColor="#636E72"
                        android:textSize="14sp" />
                </LinearLayout>


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#00B894" />

            </LinearLayout>
            <!-- Achievements & Badges Card -->
            <LinearLayout
                android:id="@+id/btn_achievements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_card_quiz"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Badges"
                        android:textColor="#2D3436"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="View your unlocked achievements"
                        android:textColor="#636E72"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#FDCB6E" />
            </LinearLayout>
            <!-- Class Leaderboard Card -->
            <LinearLayout
                android:id="@+id/btn_leaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_quiz"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:foreground="?attr/selectableItemBackground">

                <!-- Text Content -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Class Leaderboard"
                        android:textColor="#2D3436"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="See how you rank in your section"
                        android:textColor="#636E72"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Star/Trophy Icon -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="#F1C40F" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_join_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#00B894"
                android:padding="16dp"
                android:text="Join Class with Code"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <LinearLayout
                android:id="@+id/btn_open_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_level"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:text="Camera Live Scan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Scan physical books and documents in real-time"
                    android:textSize="14sp"
                    android:textColor="#F0F0F0"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Scanner"
                    android:textColor="#6C5CE7"
                    android:backgroundTint="#FFFFFF"
                    android:clickable="false"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_open_library"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_level"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:text="Digital Library"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="View and read materials assigned by your teacher"
                    android:textSize="14sp"
                    android:textColor="#F0F0F0"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Library"
                    android:textColor="#6C5CE7"
                    android:backgroundTint="#FFFFFF"
                    android:clickable="false"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_quiz" android:orientation="vertical" android:padding="20dp" android:layout_marginBottom="16dp">
                <TextView android:text="Recall Quiz" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Test your memory on past selected contexts" android:textSize="14sp" android:textColor="#2D3436" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btn_start_quiz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start Quiz" android:textColor="#000000" android:backgroundTint="#FFFFFF" android:layout_gravity="center_horizontal"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_fav" android:orientation="vertical" android:padding="20dp" android:layout_marginBottom="16dp">
                <TextView android:text="Favourites" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="View your saved texts" android:textSize="14sp" android:textColor="#2D3436" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btn_favs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View Favourites" android:textColor="#000000" android:backgroundTint="#FFFFFF" android:layout_gravity="center_horizontal"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_history" android:orientation="vertical" android:padding="20dp" android:layout_marginBottom="16dp">
                <TextView android:text="History" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Review all highlighted text blocks" android:textSize="14sp" android:textColor="#2D3436" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btn_history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View History" android:textColor="#000000" android:backgroundTint="#FFFFFF" android:layout_gravity="center_horizontal"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>