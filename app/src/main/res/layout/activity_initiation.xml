<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora"
    android:fitsSystemWindows="true">

    <!-- Frosted Top Header -->
    <com.example.gabai.FastBlurView
        android:id="@+id/blur_header_initiation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_blur_top"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_progress_tracker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:text="Apprentice Material 1 of 4"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.example.gabai.FastBlurView>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="25"
        android:progressTint="#5341CD"
        app:layout_constraintTop_toBottomOf="@id/blur_header_initiation" />

    <!-- Reading Container -->
    <LinearLayout
        android:id="@+id/reading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdf_viewer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_blur_top"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_take_quiz"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="I've Finished Reading ➔ Take Quiz"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textStyle="bold"
                android:backgroundTint="#5341CD"
                app:cornerRadius="26dp"
                app:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- AI Loading View -->
    <LinearLayout
        android:id="@+id/ai_loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.example.gabai.GabAiLoadingView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preparing assessment challenge..."
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- Quiz Question & Options Container -->
    <ScrollView
        android:id="@+id/quiz_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Redesigned Bento Question Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/initiation_question_card"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E2E8F0"
                app:contentPadding="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_bento_purple">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_task_alt"
                                app:tint="#5341CD"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_pill_translucent"
                            android:backgroundTint="#EEF2FF"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="KNOWLEDGE CHECK"
                            android:textColor="#5341CD"
                            android:textSize="11sp"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_quiz_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:lineSpacingExtra="5dp"
                        android:text="Question text goes here..."
                        android:textColor="#0F172A"
                        android:textSize="17.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:background="@drawable/bg_divider_light">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:background="@drawable/bg_level_pill"
                            android:backgroundTint="#6366F1"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_nunito_sans"
                            android:text="Choose the best answer based on the assigned material."
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_0"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginBottom="10dp"
                app:cornerRadius="18dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#EDF2F7"
                android:backgroundTint="#FFFFFF"
                android:textColor="#0F172A"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="20dp"
                android:text="Option A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginBottom="10dp"
                app:cornerRadius="18dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#EDF2F7"
                android:backgroundTint="#FFFFFF"
                android:textColor="#0F172A"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="20dp"
                android:text="Option B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginBottom="10dp"
                app:cornerRadius="18dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#EDF2F7"
                android:backgroundTint="#FFFFFF"
                android:textColor="#0F172A"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="20dp"
                android:text="Option C" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginBottom="14dp"
                app:cornerRadius="18dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#EDF2F7"
                android:backgroundTint="#FFFFFF"
                android:textColor="#0F172A"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="20dp"
                android:text="Option D" />
        </LinearLayout>
    </ScrollView>

    <!-- Final Result Container -->
    <LinearLayout
        android:id="@+id/result_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:background="@drawable/bg_app_aurora"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:elevation="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRIAL ASSESSMENT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#5341CD"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ascension Complete! 🌟"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_result_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have proven yourself worthy, scholar."
            android:textSize="14.5sp"
            android:textColor="#64748B"
            android:fontFamily="@font/font_nunito_sans"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/scores_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_stitch_white"
                    android:padding="20dp"
                    android:orientation="vertical"/>

                <LinearLayout
                    android:id="@+id/rewards_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stitch_white"
                    android:padding="20dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUESTS COMPLETED"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ Read the 4 Required Materials\n✅ Pass the Initiation Test"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#5341CD"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:textAlignment="center"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_result_action"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Accept Rank &amp; Enter GabAI ➔"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:backgroundTint="#5341CD"
            app:cornerRadius="26dp"
            app:elevation="0dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>