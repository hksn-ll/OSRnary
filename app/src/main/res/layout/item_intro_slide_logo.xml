<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!-- ================= HERO SHOWCASE STAGE ================= -->
        <FrameLayout
            android:id="@+id/stage_slide_logo"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:background="@drawable/bg_intro_hero_stage"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="4dp"
            android:padding="16dp">

            <!-- Floating Orbit Pill 1: Top-Left -->
            <LinearLayout
                android:id="@+id/badge_orbit_1"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_translucent"
                android:backgroundTint="#26FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_psychology"
                    app:tint="#C4B5FD" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="Context AI"
                    android:textColor="#F8FAFC"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Floating Orbit Pill 2: Top-Right -->
            <LinearLayout
                android:id="@+id/badge_orbit_2"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill_translucent"
                android:backgroundTint="#26FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="#6EE7B7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="IPA Audio"
                    android:textColor="#F8FAFC"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Center Physics Animated Logo -->
            <com.example.gabai.GabAiAnimatedLogoView
                android:id="@+id/intro_animated_logo"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center" />

            <!-- Floating Orbit Pill 3: Bottom-Start -->
            <LinearLayout
                android:id="@+id/badge_orbit_3"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_pill_translucent"
                android:backgroundTint="#26FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_floating_gabai_lens"
                    app:tint="#FDE68A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:text="Smart Lens"
                    android:textColor="#F8FAFC"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- ================= EDITORIAL HEADER ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_slide1_welcome_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_translucent"
                android:backgroundTint="#EDE9FE"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="INTELLIGENT READING COMPANION"
                android:textColor="#5341CD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:letterSpacing="-0.02"
                android:lineSpacingExtra="2dp"
                android:text="Read with Clarity. Master Every Word."
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/font_nunito_sans"
                android:lineSpacingExtra="2dp"
                android:text="Engineered to decode complex literature in real time so you never lose your reading momentum."
                android:textColor="#64748B"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ================= 3 VECTOR FEATURE PILLARS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- Feature 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_s1_feat_1"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_tile_purple">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_psychology"
                            app:tint="#5341CD" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:text="Context-First Comprehension"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/font_nunito_sans"
                            android:lineSpacingExtra="1.5dp"
                            android:text="Evaluates words inside your exact sentence to deliver the author's intended meaning."
                            android:textColor="#475569"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Feature 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_s1_feat_2"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_tile_blue">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_volume_up"
                            app:tint="#0984E3" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:text="Spoken Audio &amp; Grammatical Roles"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/font_nunito_sans"
                            android:lineSpacingExtra="1.5dp"
                            android:text="Hear natural pronunciation with authentic IPA phonetics and syntax analysis."
                            android:textColor="#475569"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Feature 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_s1_feat_3"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_tile_gold">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_star_filled"
                            app:tint="#D97706" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_plus_jakarta_sans"
                            android:text="Vocabulary Vault &amp; AI Quizzes"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/font_nunito_sans"
                            android:lineSpacingExtra="1.5dp"
                            android:text="Star unfamiliar terms into your personal vault and lock in retention with smart quizzes."
                            android:textColor="#475569"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
