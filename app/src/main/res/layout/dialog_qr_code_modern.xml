<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modern_dialog"
    android:fontFamily="@font/font_plus_jakarta_sans"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Badge -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_modern_primary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🏷️"
            android:textSize="24sp" />
    </FrameLayout>

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/font_plus_jakarta_sans"
        android:text="Your Classroom QR Code"
        android:textColor="#2D3436"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:fontFamily="@font/font_plus_jakarta_sans"
        android:text="Display this on your screen for students to scan."
        android:textColor="#636E72"
        android:textSize="13sp" />

    <!-- QR Code Image Card -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_modern_input"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="QR Code"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Join Code Pill with 1-Tap Copy -->
    <LinearLayout
        android:id="@+id/btn_copy_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_btn_modern_qr"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/font_plus_jakarta_sans"
            android:text="Join Code:"
            android:textColor="#636E72"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_qr_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="7X9K2P"
            android:textColor="#6C5CE7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Done Button -->
    <android.widget.Button
        android:id="@+id/btn_dialog_done"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_btn_modern_primary"
        android:fontFamily="@font/font_plus_jakarta_sans"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:text="Done"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
