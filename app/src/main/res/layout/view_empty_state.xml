<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_empty_state_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:layout_marginTop="40dp">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_bento_purple">

        <ImageView
            android:id="@+id/iv_empty_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_star_filled"
            app:tint="#5341CD" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/font_plus_jakarta_sans"
        android:text="Nothing Here Yet"
        android:textColor="#0F172A"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_empty_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/font_nunito_sans"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:maxWidth="260dp"
        android:text="Items you interact with will appear here for easy review."
        android:textColor="#64748B"
        android:textSize="13sp" />
</LinearLayout>
