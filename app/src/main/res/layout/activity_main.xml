<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora">

    <!-- Fragment container wrapped in BlurTarget so scrolling content is sampled for backdrop blur -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blur_target_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </eightbitlab.com.blurview.BlurTarget>

    <!-- Real-time Frosted Glass Floating Top Header Bar (Persistent across Home and Profile) -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@drawable/bg_glass_blur_top"
        app:blurOverlayColor="#73FFFFFF"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/header_assistant_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- Left: GabAI App Logo Squircle & Brand Lockup -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile_image"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_gabai_logo"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GabAI"
                    android:textColor="#1E1B4B"
                    android:textSize="19sp"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Reading Companion"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="@font/font_nunito_sans" />
            </LinearLayout>

            <!-- Right: Option A Interactive Material Bubble Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bubble_toggle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="Launch Bubble"
                android:textColor="#475569"
                android:textSize="12sp"
                android:fontFamily="@font/font_plus_jakarta_sans"
                android:textStyle="bold"
                app:icon="@drawable/ic_floating_gabai_lens"
                app:iconSize="16dp"
                app:iconTint="#5341CD"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="19dp"
                app:elevation="1dp"
                app:backgroundTint="#F8FAFC"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1.2dp" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- Real-time Frosted Glass Floating Bottom Navigation Bar -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_blur_nav"
        app:blurOverlayColor="#73FFFFFF"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:itemIconSize="22dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemRippleColor="#145341CD"
            app:itemPaddingTop="8dp"
            app:itemPaddingBottom="6dp"
            app:labelVisibilityMode="labeled"
            app:itemTextAppearanceActive="@style/NavLabelActive"
            app:itemTextAppearanceInactive="@style/NavLabelInactive"
            app:menu="@menu/bottom_nav_menu" />
    </eightbitlab.com.blurview.BlurView>

    <!-- Elevated Floating Circular Center Scanner Hero Button -->
    <FrameLayout
        android:id="@+id/btn_center_scanner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_scanner_circle"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/blur_bottom_nav"
        app:layout_constraintBottom_toTopOf="@id/blur_bottom_nav">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_stitch_scanner"
            app:tint="#FFFFFF"
            android:contentDescription="Open Scanner" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
