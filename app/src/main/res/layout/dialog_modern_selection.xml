<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modern_dialog"
    android:fontFamily="@font/font_plus_jakarta_sans"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Badge -->
    <FrameLayout
        android:id="@+id/dialog_badge_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_btn_modern_primary">

        <TextView
            android:id="@+id/tv_dialog_badge_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📋"
            android:textSize="26sp" />
    </FrameLayout>

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/font_plus_jakarta_sans"
        android:maxLines="2"
        android:text="Select an Option"
        android:textColor="#2D3436"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:fontFamily="@font/font_plus_jakarta_sans"
        android:text="Choose from the list below."
        android:textColor="#636E72"
        android:textSize="13sp" />

    <!-- Scrollable Items Container (max height 280dp) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_selection_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Cancel Button -->
    <android.widget.Button
        android:id="@+id/btn_dialog_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_btn_modern_secondary"
        android:fontFamily="@font/font_plus_jakarta_sans"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#636E72"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
