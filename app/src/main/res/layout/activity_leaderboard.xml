<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora">

    <!-- Sticky Glass Header Bar -->
    <com.example.gabai.FastBlurView
        android:id="@+id/blur_header_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/leaderboard_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_blur_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#1E293B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:letterSpacing="0.08"
                    android:text="HONOR ROLL &amp; STANDINGS"
                    android:textColor="#6366F1"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_leaderboard_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/font_plus_jakarta_sans"
                    android:letterSpacing="-0.02"
                    android:text="Class Leaderboard"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.example.gabai.FastBlurView>

    <!-- Frosted Blur Target Content -->
    <com.example.gabai.FastBlurTarget
        android:id="@+id/blur_target_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Leaderboard List -->
        <ScrollView
            android:id="@+id/scroll_leaderboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="84dp"
            android:paddingBottom="100dp"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top 3 Olympic Podium Section -->
            <LinearLayout
                android:id="@+id/podium_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <!-- 2nd Place (Silver) -->
                <LinearLayout
                    android:id="@+id/podium_second"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_podium_second_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_bento_lavender"
                        android:gravity="center"
                        android:textColor="#5341CD"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_podium_second_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2nd Place"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_podium_second_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 XP"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="@font/font_nunito_sans" />

                    <!-- Podium Block -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_pill_translucent"
                        android:backgroundTint="#E2E8F0"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥈"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2nd"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 1st Place (Gold - Tallest) -->
                <LinearLayout
                    android:id="@+id/podium_first"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👑"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_podium_first_avatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_bento_purple"
                        android:gravity="center"
                        android:textColor="#5341CD"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_podium_first_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="1st Place"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_podium_first_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 XP"
                        android:textColor="#D97706"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_nunito_sans" />

                    <!-- Podium Block -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_pill_translucent"
                        android:backgroundTint="#FEF3C7"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥇"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1st"
                            android:textColor="#D97706"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3rd Place (Bronze) -->
                <LinearLayout
                    android:id="@+id/podium_third"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_podium_third_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_bento_rose"
                        android:gravity="center"
                        android:textColor="#E11D48"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_podium_third_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="3rd Place"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_podium_third_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 XP"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="@font/font_nunito_sans" />

                    <!-- Podium Block -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_pill_translucent"
                        android:backgroundTint="#FFEDD5"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥉"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3rd"
                            android:textColor="#B45309"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Column Headers -->
            <LinearLayout
                android:id="@+id/layout_col_headers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="RANK &amp; SCHOLAR"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIER / XP"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_plus_jakarta_sans"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/leaderboard_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </com.example.gabai.FastBlurTarget>

    <!-- Sticky Bottom "You" Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_sticky_user"
        style="@style/Widget.Stitch.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:strokeColor="#5341CD"
        app:strokeWidth="1.5dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/tv_sticky_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#--"
                android:textColor="#5341CD"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_plus_jakarta_sans" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR STANDING"
                    android:textColor="#5341CD"
                    android:textSize="10sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_plus_jakarta_sans" />

                <TextView
                    android:id="@+id/tv_sticky_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_plus_jakarta_sans" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sticky_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lvl 1 • 0 XP"
                android:textColor="#5341CD"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_plus_jakarta_sans" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>