<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_quiz"
    android:backgroundTint="#FFFFFF"
    android:elevation="2dp"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/log_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Bug Report"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#D63031"/>

        <TextView
            android:id="@+id/btn_resolve_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MARK RESOLVED"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#0984E3"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/log_reporter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reported by: Name • Date"
        android:textSize="12sp"
        android:textColor="#B2BEC3"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/log_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description goes here..."
        android:textSize="14sp"
        android:textColor="#2D3436"/>

</LinearLayout>