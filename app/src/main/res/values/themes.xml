<resources>
    <style name="Base.Theme.GabAI" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand color system -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_variant</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <item name="android:colorBackground">@color/aurora_bg_base</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Modern aurora backdrop applied app-wide -->
        <item name="android:windowBackground">@drawable/bg_app_aurora</item>

        <!-- System bars blend into the aurora canvas -->
        <item name="android:statusBarColor">@color/aurora_bg_base</item>
        <item name="android:navigationBarColor">@color/aurora_bg_base</item>

        <!-- Modern typography system (Plus Jakarta Sans) -->
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/font_plus_jakarta_sans</item>

        <!-- Default component styles -->
        <item name="materialButtonStyle">@style/Widget.GabAI.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.GabAI.CardView</item>
    </style>

    <style name="Theme.GabAI" parent="Base.Theme.GabAI">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@style/SleekActivityAnimation</item>
    </style>

    <style name="SleekActivityAnimation" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/slide_scale_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_scale_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_scale_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_scale_pop_exit</item>
    </style>

    <style name="SleekDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_scale_enter</item>
        <item name="android:windowExitAnimation">@anim/slide_scale_exit</item>
    </style>

    <style name="Theme.GabAI.Fade" parent="Theme.GabAI">
        <item name="android:windowAnimationStyle">@style/FadeAnimation</item>
    </style>

    <style name="FadeAnimation" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Theme.GabAI.Splash" parent="Theme.GabAI">
        <item name="android:windowBackground">@drawable/bg_splash_aurora</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
