<resources>
    <style name="Base.Theme.GabAI" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand color system -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_variant</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <item name="android:colorBackground">@color/aurora_bg_base</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Modern aurora backdrop applied app-wide -->
        <item name="android:windowBackground">@drawable/bg_app_aurora</item>

        <!-- System bars blend into the aurora canvas -->
        <item name="android:statusBarColor">@color/aurora_bg_base</item>
        <item name="android:navigationBarColor">@color/aurora_bg_base</item>

        <!-- Modern typography system (Plus Jakarta Sans) -->
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/font_plus_jakarta_sans</item>

        <!-- Default component styles -->
        <item name="materialButtonStyle">@style/Widget.GabAI.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.GabAI.CardView</item>

        <!-- Modern Dialog Styling (Banish cheap purple tint app-wide) -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GabAI.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.GabAI.MaterialAlertDialog</item>
    </style>

    <style name="Theme.GabAI" parent="Base.Theme.GabAI">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@style/SleekActivityAnimation</item>
    </style>

    <style name="SleekActivityAnimation" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/slide_scale_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_scale_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_scale_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_scale_pop_exit</item>
    </style>

    <style name="SleekDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_scale_enter</item>
        <item name="android:windowExitAnimation">@anim/slide_scale_exit</item>
    </style>

    <style name="Theme.GabAI.Fade" parent="Theme.GabAI">
        <item name="android:windowAnimationStyle">@style/FadeAnimation</item>
    </style>

    <style name="FadeAnimation" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Theme.GabAI.Splash" parent="Theme.GabAI">
        <item name="android:windowBackground">@drawable/bg_splash_aurora</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.GabAI.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.GabAI.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.GabAI.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.GabAI.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.GabAI.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.GabAI.Dialog.Button.Negative</item>
    </style>

    <style name="ShapeAppearance.GabAI.Dialog" parent="">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="TextAppearance.GabAI.Dialog.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">#2D3436</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GabAI.Dialog.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">#636E72</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
    </style>

    <style name="Widget.GabAI.Dialog.Button.Positive" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#5341CD</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/font_plus_jakarta_sans</item>
    </style>

    <style name="Widget.GabAI.Dialog.Button.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#636E72</item>
        <item name="android:fontFamily">@font/font_plus_jakarta_sans</item>
    </style>
</resources>
