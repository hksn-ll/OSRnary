<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Cards ===== -->
    <style name="Widget.GabAI.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/space_lg</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
    </style>

    <!-- Glassmorphism card: translucent fill + hairline stroke, no shadow.
         Designed to sit on the aurora background. -->
    <style name="Widget.GabAI.CardView.Glass" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">@dimen/stroke_glass</item>
        <item name="contentPadding">@dimen/space_lg</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
    </style>

    <!-- Hero / gradient card wrapper (background set on inner view) -->
    <style name="Widget.GabAI.CardView.Hero" parent="Widget.GabAI.CardView">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="contentPadding">0dp</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.GabAI.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Vibrant gradient CTA (background drawable supplies the gradient) -->
    <style name="Widget.GabAI.Button.Gradient" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:background">@drawable/btn_gradient_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="elevation">@dimen/elevation_hero</item>
    </style>

    <style name="Widget.GabAI.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.GabAI.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- Small light button used on colored hero cards -->
    <style name="Widget.GabAI.Button.OnCard" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Icon buttons (48dp touch target) ===== -->
    <style name="Widget.GabAI.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/space_sm</item>
    </style>

    <!-- ===== Text appearances ===== -->
    <style name="TextAppearance.GabAI.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="TextAppearance.GabAI.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.GabAI.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.GabAI.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
